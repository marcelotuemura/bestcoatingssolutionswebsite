{
  "name": "bcs-website",
  "version": "0.1.0",
  "private": true,
  "description": "Official website and customer portal for Best Coatings Solutions (BCS).",
  "license": "UNLICENSED",
  "author": "Best Coatings Solutions",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "media:fixtures": "node scripts/generate-media-catalog-fixtures.mjs",
    "media:ingest": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/ingest-media-vault.ts",
    "media:analyze": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/analyze-media-vision.ts",
    "media:migrate:supabase": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/migrate-media-supabase.ts",
    "test:supabase:phase5": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/test-supabase-phase5.ts",
    "test:supabase:phase5:local": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/test-supabase-phase5-local-pg.ts",
    "test:supabase:phase6": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/test-supabase-phase6.ts",
    "test:supabase:phase6:local": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/test-supabase-phase5-local-pg.ts",
    "test:supabase:phase7": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/test-supabase-phase7.ts",
    "test:supabase:phase7:local": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/test-supabase-phase5-local-pg.ts",
    "media:publication:bootstrap-pg": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/bootstrap-publication-pg.ts",
    "media:supabase:apply-sql": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/apply-supabase-sql-file.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^1.4.1",
    "framer-motion": "^12.0.0",
    "next": "^15.5.4",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.53.2",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver",
      "@swc/core"
    ]
  }
}
