# ─────────────────────────────────────────────────────────────────────────────
# Best Coatings Solutions — environment variables (EXAMPLE)
#
# Copy to `.env.local` for local development. NEVER commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything below is placeholder/architecture only — integrations are not yet
# implemented (see ROADMAP.md).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (used for canonical URLs, OG tags, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Media Intelligence Platform (DAMS) ──────────────────────────────────────
# Availability flag only — NEVER authentication by itself.
# Preview/Production: when true, ACCESS + SESSION secrets are mandatory (fail closed).
MEDIA_INTELLIGENCE_ENABLED=false
# Shared owner access secret (min 16 chars). Never use NEXT_PUBLIC_*.
MEDIA_INTELLIGENCE_ACCESS_SECRET=
# HMAC session signing secret (min 16 chars). HttpOnly cookie; never expose to JS.
MEDIA_INTELLIGENCE_SESSION_SECRET=
# Local development only. Ignored on Vercel Preview/Production and NODE_ENV=production.
MEDIA_INTELLIGENCE_LOCAL_BYPASS=false
# Optional absolute/relative path to 08_Reports (media_catalog.json, etc.).
# Defaults to data/media-catalog. Falls back to fixtures when reports are missing.
MEDIA_CATALOG_DIR=
# Media vault backend: json (default) | local-filesystem | supabase | postgres
MEDIA_REPOSITORY=json
# Local vault root (originals + private derivatives). Never commit binaries.
MEDIA_VAULT_ROOT=

# ── Supabase (auth + PostgreSQL) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (customer portal payments) ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Maps / Reviews ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Scheduling ──────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Notifications (email / SMS) ─────────────────────────────────────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Analytics ───────────────────────────────────────────────────────────────
# Vercel Analytics needs no key when deployed on Vercel.
